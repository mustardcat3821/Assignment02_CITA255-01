<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment2_AListOfThings.MainPage">

    <Grid RowDefinitions="Auto, Auto, Auto" 
          ColumnDefinitions="Auto, Auto"
          Padding="24"
          RowSpacing="14"
          ColumnSpacing="16">

        <CollectionView Grid.Row="0" Grid.Column="0" x:Name ="priceList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" FontSize="16" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView Grid.Row="0" Grid.Column="1" x:Name ="itemList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" FontSize="16" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                Grid.ColumnSpan="2"
                Text="Work out the total"
                Clicked="OnTotalClicked" />


        <Label Grid.Row="2"
               Grid.ColumnSpan="2"
               x:Name="totalLabel"
               Text=""
               FontSize="22"
               FontAttributes="Bold"
               HorizontalTextAlignment="End" />

    </Grid>

</ContentPage>